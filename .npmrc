# Disable engine strict mode to allow more flexible Node.js versions
engine-strict=false

# Allow installation of packages with peer dependency conflicts
legacy-peer-deps=true

# Increase network timeout for slow connections on CI/CD
network-timeout=100000

# Save exact versions for more reproducible builds
save-exact=true

# Disable fund messages during install
fund=false

# Disable audit during install to speed up the process
audit=false

# Disable update notifications
update-notifier=false
